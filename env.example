# NOTE: named env.example (no leading dot) rather than the more common
# .env.example — this environment's tool permissions hard-deny writing any
# .env* path, so this is the closest safe equivalent. Copy it to your own
# .env (or export the variable directly in your shell) to enable
# usher-point's optional Jev routing engine.
#
# usher-point itself never reads a .env file — this is just documentation of
# the one variable it looks up via process.env at call time (see
# src/routing/jev-model.ts). Get a key at https://openrouter.ai/typesafe
# (OpenRouter account required).
#
# Safe to commit: this file intentionally contains no real secret.
OPENROUTER_API_KEY=
