{
  "targets": {
    "claudeInline": {
      "command": "claude",
      "defaultFlags": ["-p"],
      "description": "Small, single-file task that Claude Code can do inline, in this session, with no isolation."
    },
    "codexCli": {
      "command": "codex",
      "defaultModel": "gpt-6-astra",
      "defaultEffort": "high",
      "description": "Autonomous multi-file task in a single known repo, run via Codex CLI with a sandbox, no worktree isolation."
    },
    "orcaWorktree": {
      "command": "orca",
      "description": "Multi-repo, risky, or explicitly isolated task that needs its own Orca worktree before an agent touches it."
    }
  },
  "rules": [
    { "id": "quick-inline", "when": { "multiFile": false, "needsIsolation": false }, "target": "claudeInline" },
    { "id": "autonomous-single-repo", "when": { "multiFile": true, "needsIsolation": false }, "target": "codexCli", "sandbox": "workspace-write" },
    { "id": "isolated-worktree-build", "when": { "needsIsolation": true }, "target": "orcaWorktree", "spawnAgent": "codex" }
  ],
  "knownRepos": {
    "my-data-warehouse": { "worktreeRoot": "~/orca/workspaces/my-data-warehouse" },
    "my-monorepo": { "worktreeRoot": "~/orca/workspaces/my-monorepo" }
  },
  "jevModel": {
    "enabled": false,
    "model": "typesafe/jev-1.13",
    "apiKeyEnvVar": "OPENROUTER_API_KEY"
  }
}
